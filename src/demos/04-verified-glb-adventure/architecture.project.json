{
  "schemaVersion": 1,
  "projectName": "Verified-GLB Generated Adventure",
  "renderPath": "threejs-webgl2",
  "timingModel": "fixed_interpolated",
  "existingFramework": null,
  "status": "ready",
  "targetBrowsers": ["current Chromium", "current Firefox", "current Safari"],
  "capabilities": {
    "generatedAssets": true,
    "assetManifest": "public/assets/demos/04-verified-glb-adventure/manifest.json",
    "assetAuthority": "manifest",
    "gltf": true,
    "webAudio": false,
    "gamepad": false,
    "workers": false,
    "sharedArrayBuffer": false,
    "deploymentAutomation": false,
    "postprocessing": false,
    "inverseKinematics": false,
    "spatialBroadphase": false,
    "instancing": false,
    "webgpu": false,
    "canvasDynamicTextures": false,
    "semanticDom": true,
    "physics": "off",
    "persistence": "indexedDB"
  },
  "paths": {
    "frontend": ["src/demos/04-verified-glb-adventure"],
    "ignore": ["node_modules", "dist", "build", ".git", "coverage"],
    "allowedAssetLiteralFiles": ["src/demos/04-verified-glb-adventure"]
  },
  "validation": {
    "commands": ["npm run typecheck", "npm test", "npm run build"],
    "browserUrl": "http://127.0.0.1:5173/#/demo/04-verified-glb-adventure",
    "readyExpression": "() => Boolean(window.__DEMO_STATUS__ && window.__DEMO_STATUS__.state === 'ready')"
  },
  "lint": { "ignoreCodes": [], "ignorePaths": [] }
}
