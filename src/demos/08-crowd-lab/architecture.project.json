{
  "schemaVersion": 1,
  "projectName": "Instancing and Broadphase Crowd Lab",
  "renderPath": "threejs-webgl2",
  "timingModel": "fixed",
  "existingFramework": null,
  "status": "ready",
  "targetBrowsers": ["current Chromium", "current Firefox", "current Safari"],
  "capabilities": {
    "generatedAssets": false,
    "assetManifest": null,
    "assetAuthority": "none",
    "gltf": false,
    "webAudio": false,
    "gamepad": false,
    "workers": false,
    "sharedArrayBuffer": false,
    "deploymentAutomation": false,
    "postprocessing": false,
    "inverseKinematics": false,
    "spatialBroadphase": true,
    "instancing": true,
    "webgpu": false,
    "canvasDynamicTextures": false,
    "semanticDom": true,
    "performanceInstrumentation": true,
    "performanceScenarios": ["baseline", "movement", "streaming", "resource-churn", "crowd"],
    "physics": "off",
    "persistence": "none"
  },
  "notes": "Comparative browser-observable stress reference. Reports raw frame/update/render-call samples plus Three.js draw, triangle and memory counters. No cross-device FPS threshold or guarantee is asserted.",
  "paths": {
    "frontend": ["src/demos/08-crowd-lab"],
    "ignore": ["node_modules", "dist", "build", ".git", "coverage"],
    "allowedAssetLiteralFiles": []
  },
  "validation": {
    "commands": ["npm run typecheck", "npm test", "npm run build"],
    "browserUrl": "http://127.0.0.1:5173/#/demo/08-crowd-lab",
    "readyExpression": "() => Boolean(window.__DEMO_STATUS__ && window.__DEMO_STATUS__.state === 'ready')"
  },
  "lint": { "ignoreCodes": [], "ignorePaths": [] }
}
